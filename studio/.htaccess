# Block the OmniSocials key file from ever being served over the web.
# (PHP still reads it from disk; this only stops browser access.)
<FilesMatch "(omnisocials-key\.txt)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
